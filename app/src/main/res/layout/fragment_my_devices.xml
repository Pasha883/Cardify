<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewMyCards"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">


        <!-- Заголовок "Менеджмент визиток" -->
        <TextView
            android:id="@+id/tv_my_devices_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Мои устройства"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/button_text"/>

        <!-- Список визиток -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_my_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
             />

        <!-- Заглушка при отсутствии визиток -->
        <LinearLayout
            android:id="@+id/empty_state_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Устройства Cardify Touch™ не найдены.\nПодключите первое!"
                android:textSize="18sp"
                android:textColor="@color/button_text"/>

            <ImageView
                android:id="@+id/plus_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add_device"
                app:tint="@color/button_text" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

