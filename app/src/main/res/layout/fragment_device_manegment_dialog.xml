<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:padding="12dp"
    android:backgroundTint="@color/card"
    app:cardCornerRadius="30dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <TextView
            android:id="@+id/deviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device name"
            android:textAlignment="center"
            android:textColor="@color/button_text"
            android:textSize="24sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/deviceModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Cardify Touch"
            android:textColor="@color/button_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <ImageView
                android:id="@+id/icon_memory"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="State"
                android:src="@drawable/ic_memory"
                app:tint="@color/icon" />

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_memory_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Занято 0.12 Мб из 1.5 Мб памяти"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_saved"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="State"
                android:src="@drawable/ic_saved"
                app:tint="@color/icon"/>

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_data_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сохранено 4 визитки"
                android:textSize="16sp"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_state"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="State"
                android:src="@drawable/ic_offline"
                app:tint="@color/icon"/>

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_connect_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Не подключено"
                android:textSize="16sp" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_battery"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Users"
                    android:src="@drawable/ic_battery_none"
                    app:tint="@color/icon"/>

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/text_battery_charge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text=""
                    android:textSize="16sp"/>
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_serial_num"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="State"
                android:src="@drawable/ic_serial_number"
                app:tint="@color/icon"/>

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_serial_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Серийный номер: CT-00001"
                android:textSize="16sp"
                />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_manufactory_date"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="State"
                android:src="@drawable/ic_manufact_date"
                app:tint="@color/icon"/>

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_manufact_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дата производства: 06.2025"
                android:textSize="16sp"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_firmware_ver"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="State"
                android:src="@drawable/ic_firmware_ver"
                app:tint="@color/icon"/>

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_firmware_ver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Версия ПО: MENT_OS v. 0.12.0"
                android:textSize="16sp"
                />


        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_device_status"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="State"
                android:src="@drawable/ic_device_status"
                app:tint="@color/icon"/>

            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/text_device_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Статус устройства: активно"
                android:textSize="16sp"
                />


        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="12dp" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Синхронизировать данные"
            android:textColor="@color/button_text"
            android:backgroundTint="@color/buttonn"
            android:drawableLeft="@drawable/ic_sync"
            android:drawableTint="@color/button_text"
            android:layout_marginTop="24dp"
            app:cornerRadius="19dp"
            android:id="@+id/btn_sync"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Менеджмент памяти"
            android:textColor="@color/button_text"
            android:backgroundTint="@color/buttonn"
            android:drawableLeft="@drawable/ic_storage_mang"
            android:drawableTint="@color/button_text"
            android:layout_marginTop="4dp"
            app:cornerRadius="19dp"
            android:id="@+id/btn_memory_man"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical"
            android:text="Объявить устройство потерянным"
            android:textColor="@color/button_text"
            android:backgroundTint="@color/buttonn"
            android:drawableLeft="@drawable/ic_location"
            android:drawableTint="@color/button_text"
            android:layout_marginTop="4dp"
            app:cornerRadius="19dp"
            android:id="@+id/btn_lost_found"
            />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>